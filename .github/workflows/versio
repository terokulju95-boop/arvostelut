name: Nosta versio

# Ajetaan aina kun jotain työnnetään päähaaraan. Skripti kirjoittaa saman
# versioleiman kaikkiin JS-tiedostoihin ja nostaa service workerin
# VERSION-numeroa, minkä jälkeen se työntää muutoksen takaisin.
#
# SILMUKAN ESTO: workflow'n oma commit sisältää merkinnän [versio], ja
# alla oleva if-ehto ohittaa sellaiset. Ilman tätä jokainen ajo
# laukaisisi seuraavan ajon loputtomiin.

on:
  push:
    branches: [main, master]
  # Käsin ajettavissa myös Actions-välilehdeltä.
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  # Nopeat peräkkäiset pushit eivät saa nostaa versiota rinnakkain,
  # koska molemmat lukisivat saman lähtöarvon.
  group: versio-${{ github.ref }}
  cancel-in-progress: false

jobs:
  bump:
    if: >-
      github.event_name == 'workflow_dispatch' ||
      (!contains(github.event.head_commit.message, '[versio]') &&
       github.event.head_commit.author.name != 'github-actions[bot]')
    runs-on: ubuntu-latest

    steps:
      - name: Hae koodi
        uses: actions/checkout@v4
        with:
          # Tarvitaan jotta commit voidaan työntää takaisin.
          persist-credentials: true

      - name: Asenna Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Nosta versioleimat
        id: bump
        run: node tools/bump-version.js

      - name: Työnnä takaisin
        run: |
          # Jos skripti ei muuttanut mitään, ei tehdä tyhjää committia.
          if git diff --quiet; then
            echo "Ei muutoksia — ei committia."
            exit 0
          fi
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "[versio] ${{ steps.bump.outputs.stamp }} (sw ${{ steps.bump.outputs.swversion }})"
          git push

      - name: Yhteenveto
        run: |
          echo "### Versio nostettu" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- Versioleima: \`${{ steps.bump.outputs.stamp }}\`" >> $GITHUB_STEP_SUMMARY
          echo "- Service worker: \`${{ steps.bump.outputs.swversion }}\`" >> $GITHUB_STEP_SUMMARY
